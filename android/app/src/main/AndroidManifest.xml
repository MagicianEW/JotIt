<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- WebDAV, and nothing else. Without this in *main* rather than *debug*
         the app builds, installs, opens a note, and then fails every sync
         with a socket error that looks like the server is down.
         JotIt talks to one server that the user configures; it has no
         analytics, no ads, and no other network use. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!--
      The microphone, for recording a voice memo into a note.

      In *main*, not in a debug-only manifest, for the same reason as the
      INTERNET permission above: a permission that is missing from the
      release build produces an app that installs, opens a note, and then
      cannot record — with a denial that says nothing about which permission
      was missing. The prompt itself is asked for at runtime, in the
      editor, the first time the record button is used; this line only
      declares that the app is allowed to ask.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>

    <!--
      The camera plugin is here for the *desktop* capture screen, where there
      is no system camera app to hand the shutter to. On Android the shutter
      goes to the system camera through image_picker instead, and the camera
      plugin is never opened — but its manifest still lands in the merged
      one, and it brings two things that have to be undone:

      1. `android.permission.CAMERA`. Android's rule is blunt: an app that
         declares the camera permission has to ask for it at runtime, and an
         app that declares it and does not ask gets a SecurityException the
         moment it tries to open the camera. Since this app deliberately
         never asks — the system camera app holds the permission, not us —
         the declaration has to go, or the shutter button is dead on
         Android.
      2. `android.hardware.camera.any`, which defaults to *required*. That
         would take this app off the store listing for every tablet and
         Chromebook without a camera, which is a ridiculous thing for a
         notepad to do. The feature stays declared, but optional.

      The write permission came in with the camera plugin and goes with it.
    -->
    <uses-permission android:name="android.permission.CAMERA" tools:node="remove"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove"/>
    <!--
      The storage permissions came in with the same plugin. The app never
      reads the user's photos or music on its own — the picker hands back a
      URI it is already allowed to read — so the permission has no business
      in the listing: on Android 13 and later it is not even grantable any
      more, and a permission that cannot be granted is a permission the
      store flags.
    -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove"/>
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false"
        tools:replace="android:required"/>



    <!--
      Backup is off, on purpose, and this is the one Android decision here
      that should be revisited rather than left forever.

      What is in `.jotit/`: the PIN hash (PBKDF2, but still a verifier) and the
      WebDAV credentials sealed with AES-256-GCM. What seals them, today, is a
      master key stored in the same app data directory — it is not bound to the
      Android Keystore yet. Backing the directory up therefore ships both
      halves of the lock to the same place, which is strictly worse than
      having either one alone.

      When the key is bound to the Keystore, restoring the database without
      the key is harmless and this can go back to `true`. Until then, a user's
      notes do not reach Google's cloud backup, and the Settings screen shows
      the exact vault path so syncing is the backup they have been given.
    -->

    <application
        android:label="JotIt"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
