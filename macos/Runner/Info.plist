<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string></string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<!--
	  App Transport Security, narrowed to the local network.

	  The test server is `http://192.168.1.100:35115`, and ATS blocks cleartext
	  by default — the Mac equivalent of Android 9 blocking `http://`, and with
	  the same failure mode: the app builds, installs, opens a note, and every
	  sync dies on a rule the user has no way to see.

	  `NSAllowsLocalNetworking` covers `.local` names, link-local addresses and
	  the private ranges 10/8, 172.16/12 and 192.168/16 — so a NAS on the home
	  LAN works, while arbitrary cleartext to the internet does not. That is
	  deliberately tighter than Android's `cleartextTrafficPermitted="true"`,
	  which has no local-only variant because Android's network security config
	  takes hostnames and not address ranges.

	  If the server is on a public host, it needs a real certificate and an
	  `https://` URL; nothing here downgrades a TLS request.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSHumanReadableCopyright</key>
	<string>$(PRODUCT_COPYRIGHT)</string>
	<!--
	  The microphone, for recording a voice memo into a note.

	  macOS 10.14 and later refuse to open an input device unless the app says
	  what it wants the microphone for, and the refusal is a silent one: the
	  record button simply does nothing. This string is what the system shows
	  in the consent prompt, so it has to say the thing a person can decide
	  on — "record a voice memo into your notes" — rather than name a
	  permission.
	-->
	<key>NSMicrophoneUsageDescription</key>
	<string>JotIt 需要使用麦克风，把你说的语音录进笔记里。</string>
	<key>NSMainNibFile</key>
	<string>MainMenu</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
</dict>
</plist>
